# Generated from config.jsonc.in by setup/04-stow.sh (machine-specific timezone
# + auto-detected hwmon path). Only the .in template is tracked.
dotfiles/.config/waybar/config.jsonc

# Generated from settings.json.in by setup/04-stow.sh. Zed rewrites settings.json
# at runtime (ssh_connections, UI tweaks); only the .in template is tracked.
dotfiles/.config/zed/settings.json

# Generated from config.in by setup/04-stow.sh (output names from vars.sh).
# Only the .in template is tracked.
dotfiles/.config/sway/config

# Generated from wlsunset.service.in by setup/04-stow.sh (geolocation from
# vars.sh). Only the .in template is tracked.
dotfiles/.config/systemd/user/wlsunset.service

# Generated from config.in by setup/04-stow.sh (docked-profile offset from
# vars.sh). Only the .in template is tracked.
dotfiles/.config/kanshi/config
