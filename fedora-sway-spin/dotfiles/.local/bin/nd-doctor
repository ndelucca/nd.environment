#!/usr/bin/env bash
set -euo pipefail
#
# nd-doctor — chequea las suposiciones frágiles de este setup. No arregla nada: reporta.
# Correr tras actualizar el sistema, subir de versión o re-correr el bootstrap.
#
# Tres bloques (el porqué largo está en el README, sección "nd-doctor"):
#   1. Archivos del Spin de los que dependemos sin controlarlos (daemons que arranca el
#      Spin, include en capas). Si una versión futura los renombra, falla en silencio.
#   2. Lo que el setup PROMETE sobre la máquina: que vars.sh describa este hardware
#      (outputs), que lo que seteó el bootstrap siga seteado (keymaps, timezone, locale,
#      sysctl, units de sistema) y que los daemons de sesión que lanzamos estén vivos.
#      Antes el doctor solo miraba el Spin y daba 10/10 con kanshi muerto y eDP-1 en una
#      laptop con LVDS-1.
#   3. Integridad del propio despliegue: ~/.bashrc carga ~/.bashrc.d, dueño del bus de
#      notificaciones, timers nd-*, units en failed, symlinks rotos, archivos nuestros
#      huérfanos en /usr/share.
#
# Lo que necesita sesión gráfica se SALTEA (no falla) en bootstrap headless.

ok=0
fail=0
skip=0

# ~/.local/bin/nd-doctor es symlink a fedora-sway-spin/dotfiles/.local/bin/nd-doctor:
# tres niveles arriba de su directorio real está fedora-sway-spin/, donde vive vars.sh
# (SSOT de outputs, keymaps, SESSION_SERVICES...). vars.sh define DOTFILES_DIR.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SWAY_DIR="$(cd "$(dirname "${SELF}")/../../.." && pwd)"
# shellcheck source=../../../vars.sh
source "${SWAY_DIR}/vars.sh"

# Colores solo si la salida es un terminal (en el bootstrap se tee-a a un log).
if [[ -t 1 ]]; then
    C_OK=$'\033[0;32m'; C_BAD=$'\033[0;31m'; C_WHY=$'\033[0;33m'; C_OFF=$'\033[0m'
else
    C_OK=''; C_BAD=''; C_WHY=''; C_OFF=''
fi

pass() { printf '  %sOK  %s %s\n' "${C_OK}" "${C_OFF}" "$1"; ((++ok)); }
miss() { printf '  %sFALTA%s %s\n      %s↳ %s%s\n' "${C_BAD}" "${C_OFF}" "$1" "${C_WHY}" "$2" "${C_OFF}"; ((++fail)); }
omit() { printf '  %sSKIP %s %s\n      %s↳ %s%s\n' "${C_WHY}" "${C_OFF}" "$1" "${C_WHY}" "$2" "${C_OFF}"; ((++skip)); }

# check_file <ruta> <por qué> — basta con que exista.
check_file() {
    if [[ -e "$1" ]]; then pass "$1"; else miss "$1" "$2"; fi
}
# check_grep <ruta> <token> <por qué> — además debe CONTENER el token (si el Spin mantiene
# el nombre pero le saca el comando que asumimos, check_file daría un falso OK).
check_grep() {
    if grep -qs -- "$2" "$1"; then pass "$1 ($2)"; else miss "$1" "$3"; fi
}
# check_eq <qué> <esperado> <actual> <por qué>
check_eq() {
    if [[ "$2" == "$3" ]]; then pass "$1 = $2"; else miss "$1 = '${3:-}' (esperado '$2')" "$4"; fi
}

have_user_manager() { systemctl --user show-environment >/dev/null 2>&1; }
have_graphical()    { [[ "$(systemctl --user is-active graphical-session.target 2>/dev/null)" == "active" ]]; }

# ----------------------------------------------------------------------------------------
echo "Archivos del Spin de los que depende este setup:"
check_file /usr/libexec/sway/layered-include \
    "sway/config lo usa para el include en capas; sin esto NINGÚN override de config.d aplica"
check_grep /usr/share/sway/config.d/90-bar.conf swaybar_command \
    "arranca waybar (swaybar_command); por eso no hay 'exec waybar' nuestro"
check_grep /usr/share/sway/config.d/90-swayidle.conf swayidle \
    "consume \$lock_timeout/\$screen_timeout de sway/config; sin esto no hay lock por idle"
check_grep /usr/share/sway/config.d/95-autostart-policykit-agent.conf lxqt-policykit-agent \
    "arranca el agente polkit (lxqt-policykit); sin esto los prompts de privilegios fallan"
check_grep /usr/share/sway/config.d/60-bindings-media.conf playerctl \
    "provee las teclas de medios (play/next/prev → playerctl); no las bindeamos nosotros"
check_file /usr/libexec/sway-systemd/locale1-xkb-config \
    "sway/config lo ejecuta para tomar el layout de teclado de locale1; sin esto el layout queda en 'us'"
check_grep /etc/sway/config.d/10-systemd-cgroups.conf assign-cgroups \
    "mueve cada app a su propio scope de systemd; sin esto systemd-oomd no ve a las apps"

# Archivos en /usr/share/sway/config.d que ningún RPM posee: algo (una versión vieja de
# este setup, o una edición a mano) escribió ahí. Rompe la regla "no tocar /usr/share" y
# es una segunda fuente que compite con nuestros overrides.
stray=()
for f in /usr/share/sway/config.d/*.conf; do
    [[ -e "${f}" ]] || continue
    rpm -qf "${f}" &>/dev/null || stray+=("${f}")
done
if ((${#stray[@]} == 0)); then
    pass "/usr/share/sway/config.d solo tiene archivos de RPM"
else
    miss "${#stray[@]} archivo(s) sin dueño en /usr/share/sway/config.d: ${stray[*]}" \
        "huérfanos de una versión vieja del setup; 01-locale-datetime-keyboard.sh retira el de teclado"
fi

# ----------------------------------------------------------------------------------------
echo
echo "Lo que vars.sh y el bootstrap prometen sobre esta máquina:"

# Outputs: los nombres de sway coinciden con los conectores DRM del kernel, así se
# pueden validar sin sesión. Un nombre equivocado deja a kanshi sin perfil y al lid
# switch sin efecto, sin ningún error visible.
for var in OUTPUT_INTERNAL OUTPUT_EXTERNAL; do
    name="${!var}"
    if compgen -G "/sys/class/drm/card*-${name}" >/dev/null; then
        pass "${var}=${name} existe como conector DRM"
    else
        miss "${var}=${name} no es un conector de esta máquina" \
            "ver 'ls /sys/class/drm' o 'swaymsg -t get_outputs' y corregir vars.sh (kanshi/lid switch dependen de esto)"
    fi
done

# Lo que seteó 01-locale-datetime-keyboard.sh. Un `set-x11-keymap` sin --no-convert
# borraba el keymap de consola y nadie lo veía.
check_eq "VC Keymap" "${KEYMAP}" "$(localectl status 2>/dev/null | awk -F': ' '/VC Keymap/{print $2}')" \
    "lo setea 01-locale-datetime-keyboard.sh (localectl --no-convert set-keymap)"
check_eq "X11 Layout" "${KEYMAP_X11}" "$(localectl status 2>/dev/null | awk -F': ' '/X11 Layout/{print $2}')" \
    "lo setea 01-locale-datetime-keyboard.sh; de acá lo toma sway vía locale1-xkb-config"
check_eq "Timezone" "${TIMEZONE}" "$(timedatectl show -p Timezone --value 2>/dev/null)" \
    "lo setea 01-locale-datetime-keyboard.sh (timedatectl set-timezone)"
check_eq "LANG" "${LOCALE}" "$(localectl status 2>/dev/null | sed -n 's/.*LANG=//p')" \
    "lo setea 01-locale-datetime-keyboard.sh (localectl set-locale)"

# sysctl de 11-memory.sh: que lo escrito en el drop-in sea lo que corre.
SYSCTL_FILE=/etc/sysctl.d/90-nd-zram.conf
if [[ -r "${SYSCTL_FILE}" ]]; then
    while IFS='=' read -r key want; do
        key="${key// /}"; want="${want// /}"
        [[ -n "${key}" && "${key}" != \#* ]] || continue
        check_eq "sysctl ${key}" "${want}" "$(sysctl -n "${key}" 2>/dev/null)" \
            "declarado en ${SYSCTL_FILE} (11-memory.sh); 'sysctl --system' lo aplica"
    done < "${SYSCTL_FILE}"
else
    miss "${SYSCTL_FILE}" "lo escribe 11-memory.sh; sin él los vm.* vuelven a los defaults de swap en disco"
fi

# Configs generadas desde templates .in (04-stow.sh): que contengan los valores ACTUALES
# de vars.sh y ningún @PLACEHOLDER@ sin reemplazar. Editar vars.sh y olvidarse de
# re-correr 04-stow.sh dejaba el render viejo con el doctor en verde: chequeaba que el
# output existiera en DRM, nunca que el config renderizado lo usara.
# check_render <generado> <qué> <valor esperado>...
check_render() {
    local gen="$1" what="$2"; shift 2
    local missing=() v
    if [[ ! -f "${gen}" ]]; then
        miss "${what}: ${gen} no existe" "lo genera 04-stow.sh desde el .in"
        return
    fi
    if grep -qE '@[A-Z_]+@' "${gen}"; then
        miss "${what}: quedó un @PLACEHOLDER@ sin reemplazar" "04-stow.sh no conoce esa variable; revisar el template"
        return
    fi
    for v in "$@"; do grep -qF -- "${v}" "${gen}" || missing+=("${v}"); done
    if ((${#missing[@]} == 0)); then
        pass "${what} renderizado con los valores de vars.sh"
    else
        miss "${what}: falta ${missing[*]}" "vars.sh cambió y no se re-corrió 04-stow.sh (el render es viejo)"
    fi
}
check_render "${DOTFILES_DIR}/.config/sway/config" "sway/config" "${OUTPUT_INTERNAL}" "${OUTPUT_EXTERNAL}"
check_render "${DOTFILES_DIR}/.config/kanshi/config" "kanshi/config" "${OUTPUT_INTERNAL}" "${OUTPUT_EXTERNAL}" "${DOCK_LEFT_WIDTH},0"
check_render "${DOTFILES_DIR}/.config/systemd/user/wlsunset.service" "wlsunset.service" "-l ${LATITUDE} -L ${LONGITUDE}"
check_render "${DOTFILES_DIR}/.config/waybar/config.jsonc" "waybar/config.jsonc" "${TIMEZONE}"

# SDDM: el fondo del greeter va por theme.conf.user (02-...sh), nunca pisando el
# default.jxl del Spin. Ese nombre es un symlink (→ f44/default/f44-01-day.jxl, de
# f44-backgrounds-base): `cp` sobre el symlink pisaba el archivo real, y rpm -V del
# paquete del symlink no lo veía. Se verifica el archivo REAL contra su propio RPM.
SDDM_USER_CONF=/usr/share/sddm/themes/03-sway-fedora/theme.conf.user
if grep -qs '^background=/usr/share/backgrounds/wallpaper.png' "${SDDM_USER_CONF}"; then
    pass "SDDM usa nuestro wallpaper vía theme.conf.user"
else
    miss "${SDDM_USER_CONF} no apunta a nuestro wallpaper" "lo escribe 02-fonts-wallpaper-sddm-grub.sh"
fi
SDDM_DEFAULT_BG="$(readlink -f /usr/share/backgrounds/default.jxl 2>/dev/null || true)"
bg_pkg="$(rpm -qf "${SDDM_DEFAULT_BG:-/nonexistent}" 2>/dev/null || true)"
if [[ -n "${bg_pkg}" ]]; then
    # rpm -V sale 1 cuando hay diferencias: sin el `|| true`, pipefail anula el grep.
    if { rpm -V "${bg_pkg}" 2>/dev/null || true; } | grep -qF "${SDDM_DEFAULT_BG}"; then
        miss "${SDDM_DEFAULT_BG} no es el del RPM ${bg_pkg%%-[0-9]*}" \
            "lo pisaba una versión vieja de 02-...sh; re-correrlo lo reinstala"
    else
        pass "fondo default del Spin intacto (${SDDM_DEFAULT_BG##*/} es el del RPM)"
    fi
fi

# Updates: se descargan solas pero se instalan a mano (12-auto-updates.sh), y "a mano"
# sin cadencia terminó en un mes sin instalar nada. Umbral: 14 días desde el último
# upgrade registrado por dnf. awk lee todo el historial (sin `exit`) para no cortarle el
# pipe a dnf5: con pipefail eso abortaba el doctor entero sin mensaje.
UPDATE_MAX_DAYS=14
last_up="$(dnf5 history list 2>/dev/null \
    | awk '!found && $2=="dnf" && ($3=="update" || $3=="upgrade") {print $4; found=1}')" || last_up=""
if [[ -z "${last_up}" ]]; then
    omit "días desde el último dnf upgrade" "sin transacciones de upgrade en el historial de dnf"
else
    days=$(( ( $(date +%s) - $(date -d "${last_up}" +%s) ) / 86400 ))
    if (( days <= UPDATE_MAX_DAYS )); then
        pass "último dnf upgrade hace ${days} día(s) (${last_up})"
    else
        miss "último dnf upgrade hace ${days} días (${last_up})" \
            "los updates ya están descargados (dnf5-automatic); corré 'sudo dnf upgrade'"
    fi
fi

# Units de sistema que el bootstrap habilita/deshabilita.
check_eq "systemd-oomd" "active" "$(systemctl is-active systemd-oomd 2>/dev/null)" \
    "lo habilita 11-memory.sh"
check_eq "dnf5-automatic.timer" "active" "$(systemctl is-active dnf5-automatic.timer 2>/dev/null)" \
    "lo habilita 12-auto-updates.sh (descarga de updates en background)"
if systemctl list-unit-files rsyslog.service &>/dev/null; then
    check_eq "rsyslog" "inactive" "$(systemctl is-active rsyslog 2>/dev/null)" \
        "lo deshabilita 11-memory.sh (journald ya cubre el log)"
fi

# Daemons de sesión que lanza systemd --user (SESSION_SERVICES en vars.sh). Antes iban
# por exec_always de sway y se morían sin que nadie lo notara.
if ! have_graphical; then
    omit "daemons de sesión (${SESSION_SERVICES[*]})" "sin sesión gráfica (¿bootstrap headless?)"
else
    for svc in "${SESSION_SERVICES[@]}"; do
        state="$(systemctl --user is-active "${svc}" 2>/dev/null || true)"
        if [[ "${state}" == "active" ]]; then
            pass "${svc} activo"
        else
            miss "${svc} está '${state:-?}'" \
                "lo habilita setup/08-systemd-user.sh; ver 'systemctl --user status ${svc}'"
        fi
    done
    # Los watchers de cliphist sí van por `exec` de sway (no son daemons con recurso
    # exclusivo); solo chequeamos que existan.
    if pgrep -x wl-paste >/dev/null; then
        pass "watchers de cliphist (wl-paste) corriendo"
    else
        miss "no hay wl-paste corriendo" "los lanza sway/config (exec wl-paste --watch cliphist store); sin ellos no hay historial de portapapeles"
    fi
fi

# ----------------------------------------------------------------------------------------
echo
echo "Integridad del despliegue:"

# ~/.bashrc viene de /etc/skel y no se versiona; todo el shell cuelga de que recorra
# ~/.bashrc.d. Si un reset del home se lo lleva, stow sigue dejando los archivos y no
# pasa nada: falla silenciosa perfecta.
# shellcheck disable=SC2088
if grep -qs 'bashrc\.d' "${HOME}/.bashrc"; then
    pass "~/.bashrc carga ~/.bashrc.d"
else
    miss "~/.bashrc NO carga ~/.bashrc.d" \
        "sin ese loop no se aplica nada de dotfiles/.bashrc.d (prompt, alias, fzf, tmux)"
fi

# Dueño del bus de notificaciones: debe ser swaync (el tematizado). Si otro daemon gana
# el nombre de D-Bus, las notificaciones salen con otro estilo o no salen, sin error.
if ! busctl --user --no-pager status >/dev/null 2>&1; then
    omit "dueño de org.freedesktop.Notifications" "sin bus de sesión (¿bootstrap headless?)"
else
    notif_pid="$(busctl --user call org.freedesktop.DBus /org/freedesktop/DBus \
        org.freedesktop.DBus GetConnectionUnixProcessID s org.freedesktop.Notifications \
        2>/dev/null | awk '{print $2}')"
    if [[ -z "${notif_pid}" ]]; then
        miss "org.freedesktop.Notifications sin dueño" \
            "no hay daemon de notificaciones; swaync.service lo habilita 08-systemd-user.sh"
    else
        notif_cmd="$(ps -p "${notif_pid}" -o comm= 2>/dev/null || true)"
        if [[ "${notif_cmd}" == swaync* ]]; then
            pass "org.freedesktop.Notifications lo sirve swaync"
        else
            miss "org.freedesktop.Notifications lo sirve '${notif_cmd:-?}'" \
                "esperábamos swaync; otro daemon ganó el nombre de D-Bus (¿dunst/mako instalado?)"
        fi
    fi
fi

# Timers nd-*: que el archivo exista no implica que esté habilitado ni corriendo.
UNIT_DIR="${HOME}/.config/systemd/user"
if ! have_user_manager; then
    omit "timers nd-*" "sin systemd --user (¿bootstrap headless?)"
else
    shopt -s nullglob
    timers=("${UNIT_DIR}"/nd-*.timer)
    shopt -u nullglob
    if ((${#timers[@]} == 0)); then
        omit "timers nd-*" "no hay ninguno en ${UNIT_DIR}"
    else
        for t in "${timers[@]}"; do
            name="$(basename "${t}")"
            if [[ "$(systemctl --user is-active "${name}" 2>/dev/null)" == "active" ]]; then
                pass "${name} activo"
            else
                miss "${name} NO está activo" \
                    "lo habilita setup/08-systemd-user.sh; su tarea no se está ejecutando"
            fi
        done
    fi
fi

# Units de usuario en failed: una unit caída no se reintenta sola, solo se ve si alguien
# la mira. Complementa al chequeo del bus (que puede dar OK con la unit caída al lado).
if ! have_user_manager; then
    omit "units de usuario en failed" "sin systemd --user (¿bootstrap headless?)"
else
    mapfile -t failed_units < <(
        systemctl --user list-units --state=failed --no-legend --plain 2>/dev/null \
            | awk '{print $1}'
    )
    if ((${#failed_units[@]} == 0)); then
        pass "sin units de usuario en failed"
    else
        miss "${#failed_units[@]} unit(s) de usuario en failed: ${failed_units[*]}" \
            "ver 'systemctl --user status <unit>'; una unit caída no se reintenta sola"
    fi
fi

# Symlinks rotos apuntando al repo: los deja un rename/borrado de un dotfile. 04-stow.sh
# los limpia al correr; si aparecen acá, el stow quedó desfasado del repo.
broken=()
for pkg in .bashrc.d .config .local; do
    [[ -d "${HOME}/${pkg}" ]] || continue
    while IFS= read -r link; do
        [[ "$(readlink -m "${link}")" == "${DOTFILES_DIR}/"* ]] && broken+=("${link}")
    done < <(find "${HOME}/${pkg}" -xtype l 2>/dev/null)
done
if ((${#broken[@]} == 0)); then
    pass "sin symlinks rotos hacia el repo"
else
    miss "${#broken[@]} symlink(s) roto(s): ${broken[0]}${broken[1]+ ...}" \
        "el stow quedó desfasado del repo; re-correr setup/04-stow.sh los limpia"
fi

# ----------------------------------------------------------------------------------------
echo
if ((fail > 0)); then
    printf '%s%d suposición(es) rotas%s, %d ok%s. Revisar el README.\n' \
        "${C_BAD}" "${fail}" "${C_OFF}" "${ok}" \
        "$( ((skip > 0)) && printf ', %d salteadas' "${skip}")"
    exit 1
fi
printf '%sTodo en orden%s (%d/%d%s). El Spin, vars.sh y el despliegue coinciden con la máquina.\n' \
    "${C_OK}" "${C_OFF}" "${ok}" "${ok}" \
    "$( ((skip > 0)) && printf ', %d salteadas' "${skip}")"
